// Reglas de seguridad de Firestore para la Bitácora de Trading.
// Se pegan en Firebase → Firestore Database → Reglas → Publicar.
// Cambia TU_CORREO@gmail.com por tu correo (en minúsculas) SOLO en la consola
// de Firebase: este repositorio es público, así que aquí queda el marcador.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada usuario solo puede tocar su propio espacio, y solo la cuenta autorizada puede entrar.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.auth.token.email == "TU_CORREO@gmail.com";
    }
  }
}
